// CARBUGUI — carburant Guinée
// Data model for the API backing the Expo app in ./expo.
//
// Conventions
//   - Tables are snake_case via @@map; Prisma fields stay camelCase.
//   - Money is an integer number of GNF (the franc guinéen has no minor unit).
//   - Every timestamp is stored UTC; the client formats for fr-GN.
//   - Ids are cuid() so they can be minted client-side for optimistic writes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------


enum AccountRole {
  DRIVER
  STATION
  ADMIN
}

enum AccountStatus {
  /// Self-registered STATION account awaiting admin approval. Can read its
  /// dashboard but every write is rejected (403) until an admin sets it ACTIVE.
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum StationMemberRole {
  OWNER
  STAFF
}


enum FuelProduct {
  ESSENCE
  GASOIL
  /// Gaz butane (bouteilles). priceGnf = prix de la bouteille.
  GAZ
  /// Huiles moteur / lubrifiants. priceGnf = prix indicatif.
  LUBRIFIANT
}


enum Availability {
  AVAILABLE
  EMPTY
}

enum StationActivityKind {
  AVAILABILITY
  OPEN_STATE
  PRICE
  VERIFICATION
}


enum ActivityTone {
  AVAILABLE
  EMPTY
  OPEN
  CLOSED
}


enum OtpPurpose {
  SIGN_IN
  PHONE_CHANGE
  PIN_RESET
}

enum ChatRole {
  USER
  BOT
  AGENT
}

enum ChatThreadStatus {
  OPEN
  ESCALATED
  CLOSED
}

enum ReportKind {
  WRONG_AVAILABILITY
  WRONG_OPEN_STATE
  WRONG_LOCATION
  CLOSED_PERMANENTLY
  OTHER
}

enum ReportStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// Lifecycle of one Djomy payment-link checkout (see utils/djomy.js).
enum PaymentStatus {
  /// Link generated, waiting for the driver to pay.
  PENDING
  /// Djomy confirmed SUCCESS — a Subscription row was created for it.
  SUCCEEDED
  FAILED
  /// The payer canceled on the Djomy portal.
  CANCELED
  /// The link expired without any successful payment.
  EXPIRED
}

enum AdminMessageRecipientStatus {
  PENDING
  SENT
  FAILED
  /// The account has no phoneNumber on file, so nothing was attempted.
  SKIPPED
}

enum AdminMessageStatus {
  /// scheduledAt hasn't arrived yet — the poller in utils/adminMessaging.js
  /// hasn't dispatched it. Also the (brief) state of an immediate send while
  /// its request handler is still running.
  SCHEDULED
  SENT
  /// An admin canceled it before scheduledAt arrived. Recipients stay
  /// PENDING — they were simply never attempted.
  CANCELED
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

/// One row per person or station login. Drivers authenticate with a phone
/// number + SMS code; station accounts with a code + password. The invariant
/// "DRIVER has phoneNumber, STATION has loginCode + passwordHash" is enforced
/// in the service layer — Prisma cannot express a CHECK constraint.
model Account {
  id     String        @id @default(cuid())
  role   AccountRole   @default(DRIVER)
  status AccountStatus @default(ACTIVE)

  /// E.164, always +224XXXXXXXXX for Guinea. Null for admin-provisioned
  /// station accounts; a self-registered station account stores the agent's
  /// contact number here too, so it shares the same uniqueness as drivers.
  phoneNumber String? @unique
  fullName    String?
  locale      String  @default("fr")

  /// Fallback search zone used when the device refuses location.
  defaultAreaId String?
  defaultArea   Area?   @relation(fields: [defaultAreaId], references: [id], onDelete: SetNull)

  /// Station credentials (argon2id hash — never the password itself).
  loginCode    String? @unique
  passwordHash String?

  /// Quick-unlock PIN (4-6 digits, DRIVER only): set once via
  /// /app/auth/pin/set right after an OTP login, then checked by
  /// /app/auth/pin/login on later app opens so a still-valid session doesn't
  /// need a fresh SMS. Locked out after too many wrong tries; /app/auth/pin/forgot
  /// + /app/auth/pin/reset recover it with one SMS confirmation code.
  pinHash        String?
  pinAttempts    Int       @default(0)
  pinLockedUntil DateTime?

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships           StationMembership[]
  sessions              Session[]
  pushTokens            PushToken[]
  searches              SearchEvent[]
  chatThreads           ChatThread[]
  reports               StationReport[]
  activities            StationActivity[]
  sentAdminMessages     AdminMessage[]          @relation("AdminMessageSender")
  receivedAdminMessages AdminMessageRecipient[] @relation("AdminMessageRecipientAccount")
  subscriptions         Subscription[]
  payments              Payment[]

  @@index([role, status])
  @@index([defaultAreaId])
  @@map("accounts")
}

/// A refresh token in flight. One row per device; revoking it signs that
/// device out.
model Session {
  id        String @id @default(cuid())
  accountId String

  /// SHA-256 of the refresh token. The raw token never reaches the database.
  refreshTokenHash String          @unique
  deviceId         String?
  deviceName       String?
  platform         DevicePlatform?
  ipAddress        String?

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// An SMS code awaiting verification. Keyed by phone rather than account: on a
/// first sign-in the account does not exist yet.
model OtpChallenge {
  id          String     @id @default(cuid())
  phoneNumber String
  purpose     OtpPurpose @default(SIGN_IN)

  /// Hash of the 6-digit code, never the code itself.
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  expiresAt   DateTime
  consumedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model PushToken {
  id         String         @id @default(cuid())
  accountId  String
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("push_tokens")
}

// ---------------------------------------------------------------------------
// Geography & stations
// ---------------------------------------------------------------------------

/// A search zone offered when the device position is unavailable. Seeded from
/// areaOptions in AppContext: Conakry centre, Kaloum, Dixinn, Matam, Ratoma,
/// Matoto.
model Area {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  latitude  Float
  longitude Float
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  stations Station[]
  accounts Account[]
  searches SearchEvent[]

  @@map("areas")
}

/// TotalEnergies, Shell, Star Oil… A table rather than free text so the app can
/// filter by network and show a logo.
model Brand {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  logoUrl String?

  stations Station[]

  @@map("brands")
}



model Station {
  id String @id @default(cuid())

  /// Human-readable key ("kaloum"); also the station account's login code.
  slug String @unique
  name String

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  /// Search zone (commune) the station belongs to.
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  /// Free-text quartier shown under the station name ("Almamy", "Donka").
  /// This is what the client renders as `Station.area`.
  neighborhood String?
  city         String  @default("Conakry")
  address      String?
  phoneNumber  String?

  latitude  Float
  longitude Float

  /// Set when the station was imported from Google Places (New).
  googlePlaceId String? @unique

  isOpen       Boolean   @default(true)
  isPublished  Boolean   @default(true)
  verifiedAt   DateTime?
  openingHours Json?

  /// Bumped ONLY when availability or the open flag changes — this is the
  /// timestamp the app ages ("à jour" under 1 h, "à confirmer" under 4 h,
  /// "périmé" beyond). Distinct from updatedAt, which moves on any edit.
  statusUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    StationProduct[]
  activities  StationActivity[]
  memberships StationMembership[]
  reports     StationReport[]

  @@index([latitude, longitude])
  @@index([isPublished, statusUpdatedAt])
  @@index([areaId])
  @@index([brandId])
  @@map("stations")
}

/// Which staff account may update which station.
model StationMembership {
  id        String            @id @default(cuid())
  accountId String
  stationId String
  role      StationMemberRole @default(STAFF)
  createdAt DateTime          @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([accountId, stationId])
  @@index([stationId])
  @@map("station_memberships")
}

/// The live status of one product at one station. The row's existence means the
/// station sells that product; `availability` says whether it currently has any.
model StationProduct {
  id           String       @id @default(cuid())
  stationId    String
  product      FuelProduct
  availability Availability @default(EMPTY)

  /// Optional posted price per litre.
  priceGnf Int?

  updatedAt   DateTime @updatedAt
  updatedById String?

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, product])
  @@index([product, availability])
  @@map("station_products")
}

/// Append-only feed behind the dashboard's activity list, and the audit trail
/// for "who said this station had fuel". Never updated, only inserted.
model StationActivity {
  id        String              @id @default(cuid())
  stationId String
  accountId String?
  kind      StationActivityKind
  tone      ActivityTone

  /// Rendered as-is by the dashboard: label "Essence", detail "Marqué
  /// disponible". Denormalised so old entries keep their original wording.
  label  String
  detail String

  product      FuelProduct?
  availability Availability?
  isOpen       Boolean?

  createdAt DateTime @default(now())

  station Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([stationId, createdAt])
  @@index([accountId, createdAt])
  @@map("station_activities")
}

/// A driver contesting what a station published. Feeds the trust score and
/// tells a station its statuses have gone stale.
model StationReport {
  id        String       @id @default(cuid())
  stationId String
  accountId String?
  kind      ReportKind
  product   FuelProduct?
  comment   String?
  status    ReportStatus @default(PENDING)

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  station Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([stationId, createdAt])
  @@index([status])
  @@map("station_reports")
}

// ---------------------------------------------------------------------------
// Support & analytics
// ---------------------------------------------------------------------------

model ChatThread {
  id        String           @id @default(cuid())
  accountId String
  status    ChatThreadStatus @default(OPEN)

  /// Set when the bot handed the conversation over to WhatsApp.
  escalatedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([accountId, updatedAt])
  @@index([status])
  @@map("chat_threads")
}

model ChatMessage {
  id       String   @id @default(cuid())
  threadId String
  role     ChatRole
  text     String

  /// Which botBrain intent produced this reply, for tuning the FAQ.
  intentId  String?
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

/// One search, for coverage analytics: where people look, for which product,
/// and whether anything nearby actually had fuel.
model SearchEvent {
  id        String  @id @default(cuid())
  accountId String?
  areaId    String?

  product     FuelProduct
  latitude    Float
  longitude   Float
  radiusKm    Float       @default(5)
  resultCount Int         @default(0)

  /// Results that actually had the product, to spot dry days per quartier.
  availableCount Int @default(0)

  createdAt DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  area    Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([accountId, createdAt])
  @@map("search_events")
}

// ---------------------------------------------------------------------------
// Admin messaging
// ---------------------------------------------------------------------------

/// One custom SMS an admin sends to a hand-picked list of DRIVER or STATION
/// accounts. Delivery is tracked per recipient (AdminMessageRecipient) since
/// a batch send can partially fail — a typo'd number shouldn't hide that the
/// other 40 texts went through.
model AdminMessage {
  id       String             @id @default(cuid())
  senderId String
  body     String
  status   AdminMessageStatus @default(SCHEDULED)

  /// When to dispatch. Defaults to "now" for an immediate send, so the same
  /// poller query (status SCHEDULED, scheduledAt <= now) also catches an
  /// immediate send whose request never finished — nothing is silently lost.
  scheduledAt  DateTime  @default(now())
  dispatchedAt DateTime?

  createdAt DateTime @default(now())

  sender     Account                  @relation("AdminMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipients AdminMessageRecipient[]

  @@index([senderId, createdAt])
  @@index([status, scheduledAt])
  @@map("admin_messages")
}

/// Delivery outcome of one AdminMessage for one recipient. phoneNumber is a
/// snapshot taken at send time, so the row stays meaningful even if the
/// account's number changes later.
model AdminMessageRecipient {
  id          String                       @id @default(cuid())
  messageId   String
  accountId   String
  phoneNumber String?
  status      AdminMessageRecipientStatus  @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime                     @default(now())

  message AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  account Account      @relation("AdminMessageRecipientAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([accountId, status])
  @@map("admin_message_recipients")
}

// ---------------------------------------------------------------------------
// Abonnements & paiements (Djomy)
// ---------------------------------------------------------------------------

/// A subscription offer ("24 heures", "1 mois"). Seeded by prisma/seed.js;
/// the price is editable by an admin without a deploy.
model Plan {
  id            String  @id @default(cuid())
  /// Stable key used by the API and the frontend: "DAY", "MONTH".
  code          String  @unique
  label         String
  priceGnf      Int
  /// Access granted by one purchase (24 for DAY, 720 for MONTH).
  durationHours Int
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

/// One paid access period. A purchase made while a period is still running
/// starts when that period ends, so buying early never loses paid time. An
/// account "is subscribed" when a row covers now (startsAt <= now < endsAt).
model Subscription {
  id        String @id @default(cuid())
  accountId String
  planId    String
  /// The payment that bought this period — unique, so a replayed webhook
  /// can never grant the same period twice.
  paymentId String @unique

  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([accountId, endsAt])
  @@map("subscriptions")
}

/// One Djomy payment-link checkout. Created PENDING when the link is
/// generated, then settled by the webhook (or by the reconciliation poller
/// if the webhook never arrives). Money fields are copied from Djomy once
/// the payment is confirmed through GET /v1/payments/{id}/status.
model Payment {
  id        String        @id @default(cuid())
  accountId String
  planId    String
  amountGnf Int
  status    PaymentStatus @default(PENDING)

  /// Our reference sent to Djomy (merchantReference) and echoed back as
  /// merchantPaymentReference in the webhook — the primary lookup key.
  merchantReference    String    @unique
  paymentLinkReference String?   @unique
  paymentUrl           String?   @db.Text
  linkExpiresAt        DateTime?

  /// Filled once Djomy reports a transaction for this link.
  transactionId     String? @unique
  paymentMethod     String?
  payerIdentifier   String?
  paidAmount        Int?
  receivedAmount    Int?
  fees              Int?
  providerReference String?
  failureReason     String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription?

  @@index([accountId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Raw log of every webhook call received, for audit and debugging. Never
/// trusted on its own: the payment status is always re-read from the Djomy
/// API before anything is granted.
model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String?
  eventType      String?
  signatureValid Boolean   @default(false)
  payload        Json
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  error          String?   @db.Text

  @@index([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}
