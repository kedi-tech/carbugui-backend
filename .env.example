# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_KEY=

# Database (MySQL)
DATABASE_URL="mysql://user:password@host:3306/carbugui"
DIRECT_URL="mysql://user:password@host:3306/carbugui"

# Seed (bootstrap admin account created by `npm run seed`)
SEED_ADMIN_PHONE=+224610000000
SEED_ADMIN_PASSWORD=change-me

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# SMS (NimbaSMS)
SMS_API_URL=https://api.nimbasms.com/v1
SMS_API_KEY=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SYSTEM_EMAIL=

# Rate limiting (fenêtre en ms / nombre max de requêtes par IP)
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=500

# Paiement Djomy (abonnements) — https://developers.djomy.africa
# Sandbox : https://sandbox-api.djomy.africa
DJOMY_BASE_URL=https://sandbox-api.djomy.africa
DJOMY_CLIENT_ID=
DJOMY_CLIENT_SECRET=
# Redirections après paiement (https obligatoire, sinon Djomy répond 400)
DJOMY_RETURN_URL=
DJOMY_CANCEL_URL=
# Durée de validité d'un lien de paiement (minutes)
DJOMY_LINK_TTL_MINUTES=15
# true = Djomy envoie aussi le lien par SMS au chauffeur
DJOMY_SEND_SMS=false
# true = rejette (401) tout webhook sans signature X-Webhook-Signature valide
DJOMY_WEBHOOK_REQUIRE_SIGNATURE=false

# Abonnements : false = recherche de stations ouverte sans abonnement
SUBSCRIPTION_REQUIRED=true
